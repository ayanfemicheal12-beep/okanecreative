:root{
  --cream:#f5f2e9;
  --paper:#fbf8ef;
  --teal:#1f4e5a;
  --teal-deep:#17383f;
  --orange:#c4602b;
  --ink:#1d2a2e;
  --line:rgba(31,78,90,.28);
  --radius:4px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--ink);font:400 1.0625rem/1.7 'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{color:var(--teal);text-underline-offset:3px}
a:hover{color:var(--orange)}
:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
.skip{position:absolute;left:-999px;top:8px;background:var(--teal);color:#fff;padding:.6rem 1rem;z-index:300}
.skip:focus{left:8px;color:#fff}
.wrap{width:min(1120px,100% - 48px);margin-inline:auto}

h1,h2,h3{font-family:'Fraunces',Georgia,'Times New Roman',serif;color:var(--teal);font-weight:600;line-height:1.12;margin:0 0 .5em;letter-spacing:-.012em}
h1{font-size:clamp(2.5rem,5.8vw,4.5rem);font-weight:700;letter-spacing:-.02em}
h2{font-size:clamp(1.75rem,3.3vw,2.6rem)}
h3{font-size:1.28rem}
p{margin:0 0 1.1em;max-width:62ch}
.lede{font-size:clamp(1.12rem,1.6vw,1.3rem);line-height:1.6;max-width:56ch}
.small{font-size:.94rem}
.muted{color:rgba(29,42,46,.72)}

/* header */
.site{position:sticky;top:0;z-index:100;background:rgba(245,242,233,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:72px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--teal)}
.brand img{height:46px;width:auto}
.brand span{font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:1.3rem;letter-spacing:-.01em}
.site-nav{display:flex;align-items:center;gap:26px}
.site-nav a{text-decoration:none;color:var(--ink);font-weight:500;padding:.3rem 0;border-bottom:2px solid transparent}
.site-nav a:hover{color:var(--orange);border-bottom-color:var(--orange)}
.site-nav a[aria-current="page"]{border-bottom-color:var(--teal);color:var(--teal)}
.site-nav a.btn{border:2px solid var(--teal);padding:.45em 1.05em}
.site-nav a.btn:hover{border-color:var(--teal);color:#fff}
.nav-toggle{display:none;font:inherit;font-weight:700;background:none;border:2px solid var(--teal);color:var(--teal);padding:.4em .9em;border-radius:var(--radius);cursor:pointer}

/* buttons */
.btn{display:inline-block;padding:.8em 1.5em;border:2px solid var(--teal);border-radius:var(--radius);font-weight:700;text-decoration:none;color:var(--teal);background:transparent;transition:background .15s,color .15s,border-color .15s}
.btn:hover{background:var(--teal);color:#fff}
.btn.primary{background:var(--orange);border-color:var(--orange);color:#fff}
.btn.primary:hover{background:var(--teal);border-color:var(--teal)}
.btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:1.6rem}

/* hero */
.hero{padding:clamp(40px,7vw,100px) 0 clamp(48px,7vw,96px)}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(28px,5vw,72px);align-items:center}
.hero h1{max-width:13ch}
.hero-art{position:relative;justify-self:center;width:min(100%,400px)}
.hero-art::before{content:"";position:absolute;inset:6% 4% 2% 10%;border:3px solid var(--orange);border-radius:52% 48% 55% 45%/46% 54% 46% 54%;transform:rotate(-8deg);opacity:.55}
.hero-art img{position:relative;width:100%;animation:settle 1.2s cubic-bezier(.2,.7,.2,1) both}
@keyframes settle{from{opacity:0;transform:translateY(16px) rotate(-3deg)}to{opacity:1;transform:none}}

/* sections */
.section{padding:clamp(48px,7vw,92px) 0}
.section.tight{padding-top:0}
.section-head{max-width:46rem;margin-bottom:2rem}
.rows{border-top:2px solid var(--teal)}
.row{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.6fr);gap:10px 44px;padding:1.55rem 0;border-bottom:1px solid var(--line)}
.row h3{margin:0}
.row p{margin:0 0 .6em}
.row p:last-child{margin-bottom:0}
.row .more{font-weight:700}

.feature{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(28px,5vw,64px);align-items:center}
.framed{border:2px solid var(--teal);border-radius:2px;background:var(--paper)}

.statement{background:var(--paper);border-block:1px solid var(--line);padding:clamp(44px,6vw,76px) 0}
.statement blockquote{margin:0;font-family:'Fraunces',Georgia,serif;font-size:clamp(1.4rem,2.7vw,2.1rem);line-height:1.36;color:var(--teal);max-width:34ch;font-weight:500}
.statement p{margin:1.2rem 0 0}

.band{background:var(--teal);color:#f1ebdc;padding:clamp(48px,6vw,80px) 0}
.band h2{color:#f7f1e1;max-width:20ch}
.band p{color:#e3dccb}
.band .btn{border-color:#f1ebdc;color:#f1ebdc}
.band .btn:hover{background:#f1ebdc;color:var(--teal)}
.band .btn.primary{background:var(--orange);border-color:var(--orange);color:#fff}
.band .btn.primary:hover{background:#f1ebdc;border-color:#f1ebdc;color:var(--teal)}

/* page title */
.page-head{padding:clamp(40px,6vw,80px) 0 clamp(20px,3vw,36px)}
.page-head h1{font-size:clamp(2.2rem,4.8vw,3.6rem);max-width:18ch}

/* steps */
.steps{list-style:none;counter-reset:s;margin:0;padding:0;border-top:2px solid var(--teal)}
.steps li{counter-increment:s;display:grid;grid-template-columns:64px minmax(0,1fr);gap:18px;padding:1.5rem 0;border-bottom:1px solid var(--line)}
.steps li::before{content:counter(s);font-family:'Fraunces',Georgia,serif;font-weight:700;font-size:2.4rem;line-height:1;color:var(--orange)}
.steps h3{margin-bottom:.25em}
.steps p{margin:0}
.plain{margin:0 0 1.4rem;padding-left:1.2rem}
.plain li{margin-bottom:.5rem;max-width:60ch}

/* work */
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:30px 26px;margin:2rem 0}
.gallery figure{margin:0}
.gallery figcaption{margin-top:.7rem;font-size:.95rem;line-height:1.5;color:rgba(29,42,46,.82)}
.zoom{display:block;width:100%;padding:0;border:0;background:none;cursor:zoom-in}
.zoom img{border:2px solid var(--teal);border-radius:2px;background:var(--paper)}
.zoom:hover img{border-color:var(--orange)}
.credit{border-left:4px solid var(--orange);padding:.2rem 0 .2rem 1rem;margin:1.5rem 0;max-width:58ch}
.spots{border-top:2px solid var(--teal);margin:1.6rem 0}
.spot{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 20px;padding:1rem 0;border-bottom:1px solid var(--line)}
.spot strong{font-family:'Fraunces',Georgia,serif;font-size:1.2rem;color:var(--teal);font-weight:600}
.spot span{color:rgba(29,42,46,.72)}
.spot a{font-weight:700}
.lightbox{position:fixed;inset:0;background:rgba(23,56,63,.93);display:none;place-items:center;padding:24px;z-index:400}
.lightbox.open{display:grid}
.lightbox img{max-height:88vh;max-width:min(1100px,94vw);border:3px solid var(--cream);background:var(--cream)}
.lightbox button{position:absolute;top:16px;right:16px;font:inherit;font-weight:700;background:var(--cream);color:var(--teal);border:0;padding:.55em 1em;border-radius:var(--radius);cursor:pointer}

/* contact */
.contact-list{border-top:2px solid var(--teal);margin:1.5rem 0 2rem}
.contact-list div{display:grid;grid-template-columns:130px minmax(0,1fr);gap:16px;padding:1.1rem 0;border-bottom:1px solid var(--line)}
.contact-list dt{font-weight:700;color:var(--teal)}
.contact-list dd{margin:0}

/* footer */
.foot{background:var(--teal-deep);color:#d9d3c2;padding:52px 0 30px;font-size:.96rem}
.foot a{color:#f1ebdc}
.foot a:hover{color:#ffb98f}
.foot-grid{display:grid;grid-template-columns:minmax(0,1.3fr) repeat(2,minmax(0,1fr));gap:36px}
.foot-brand{display:flex;gap:14px;align-items:flex-start}
.foot-brand img{height:64px;width:auto;border-radius:3px;background:var(--cream);padding:4px}
.foot h3{font-size:1.05rem;color:#f1ebdc;margin-bottom:.6rem}
.foot ul{list-style:none;margin:0;padding:0}
.foot li{margin-bottom:.4rem}
.foot .legal{margin-top:34px;padding-top:18px;border-top:1px solid rgba(241,235,220,.2);font-size:.88rem;color:#b9b3a3}

@media (max-width:820px){
  .nav-toggle{display:inline-block}
  .site-nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:flex-start;gap:6px;background:var(--cream);padding:14px 24px 22px;border-bottom:1px solid var(--line)}
  .site-nav.open{display:flex}
  .site-nav a{padding:.6rem 0;font-size:1.1rem}
  .hero .wrap,.feature,.row,.foot-grid{grid-template-columns:1fr}
  .hero-art{width:min(70%,300px);order:-1;justify-self:start}
  .hero h1{max-width:none}
  .steps li{grid-template-columns:48px minmax(0,1fr)}
  .contact-list div{grid-template-columns:1fr;gap:2px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .hero-art img{animation:none}
  *{transition:none!important}
}

.foot a,.contact-list a{overflow-wrap:anywhere}
.contact-list dd{line-height:1.9}
.contact-list+h2{margin-top:3rem}
